<Window x:Class="UnSetBim.Modules.Architectural.HumanizedPlan.HumanizedPlanOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UnSet BIM — Planta Humanizada IA"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UnSetBim.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Selectable style card -->
            <Style x:Key="StyleCard" TargetType="RadioButton">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Root" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1" CornerRadius="10" Padding="14,9">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource BgCardHover}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentLight}"/>
                                    <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentDim}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="26,22,26,20">
        <TextBlock Text="Planta Humanizada IA" Style="{StaticResource TitleText}"/>
        <TextBlock x:Name="ViewInfoText" Style="{StaticResource BodyText}" Margin="0,4,0,0"/>

        <Border x:Name="NoRoomsBanner" Style="{StaticResource WarningBanner}" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource TextPrimary}"
                       Text="Nenhum ambiente (Room) encontrado nesta planta. A imagem é exportada normalmente, mas o prompt vai pedir para a IA identificar os ambientes pelo formato. Para um resultado melhor, coloque ambientes com nome."/>
        </Border>

        <TextBlock Text="ESTILO" Style="{StaticResource SectionLabel}" Margin="0,18,0,8"/>
        <StackPanel x:Name="StylesPanel"/>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="IDIOMA DO PROMPT" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                <ComboBox x:Name="LanguageCombo" Style="{StaticResource DarkComboBox}">
                    <ComboBoxItem Content="Inglês (recomendado)" Tag="English"/>
                    <ComboBoxItem Content="Português" Tag="Portuguese"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2">
                <TextBlock Text="LARGURA DA IMAGEM" Style="{StaticResource SectionLabel}" Margin="0,0,0,6"/>
                <ComboBox x:Name="WidthCombo" Style="{StaticResource DarkComboBox}">
                    <ComboBoxItem Content="4.000 px (mais rápido)" Tag="4000"/>
                    <ComboBoxItem Content="6.000 px (recomendado)" Tag="6000"/>
                    <ComboBoxItem Content="8.000 px (máxima nitidez)" Tag="8000"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <CheckBox x:Name="FurnishCheck" Margin="0,14,0,0" Foreground="{StaticResource TextPrimary}"
                  Content="Pedir para a IA mobiliar os ambientes"/>

        <TextBlock Text="OBSERVAÇÕES PARA A IA (OPCIONAL)" Style="{StaticResource SectionLabel}" Margin="0,16,0,6"/>
        <TextBox x:Name="NotesBox" Style="{StaticResource InputTextBox}" Height="64" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                 ToolTip="Ex.: piscina com borda infinita, cozinha com marcenaria branca, muito verde no jardim"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" IsCancel="True" Click="OnCancel"/>
            <Button Content="Exportar imagem e prompt" Style="{StaticResource PrimaryButton}" IsDefault="True"
                    Margin="10,0,0,0" Click="OnExport"/>
        </StackPanel>
    </StackPanel>
</Window>
