<Window x:Class="UnSetBim.Framework.Account.SignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnSetBim.Framework.Account"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:SignInViewModel}"
        Title="UnSet BIM — Entrar"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UnSetBim.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="32,28,32,28">

        <!-- Header -->
        <Border Style="{StaticResource LogoMark}" Width="44" Height="44" CornerRadius="11" HorizontalAlignment="Center">
            <TextBlock Text="U" FontSize="22" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Entrar no UnSet BIM" Style="{StaticResource TitleText}" FontSize="19"
                   HorizontalAlignment="Center" Margin="0,14,0,0"/>
        <TextBlock Text="Use a mesma conta do site unset.com.br" FontSize="12.5"
                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,20"/>

        <!-- Info (e.g. session expired) -->
        <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,14"
                Visibility="{Binding InfoMessage, Converter={StaticResource HasValueToVis}}">
            <TextBlock Text="{Binding InfoMessage}" Foreground="{StaticResource TextPrimary}" FontSize="12.5" TextWrapping="Wrap"/>
        </Border>

        <!-- Error -->
        <Border Style="{StaticResource ErrorBanner}" Margin="0,0,0,14"
                Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Danger}" FontSize="12.5" TextWrapping="Wrap"/>
        </Border>

        <!-- ══ Step 1: choose ══ -->
        <StackPanel Visibility="{Binding IsChooseStep, Converter={StaticResource BoolToVis}}">
            <Button Style="{StaticResource PrimaryButton}" Height="44" Command="{Binding BrowserSignInCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Entrar pelo navegador" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
            <TextBlock Text="Recomendado. Funciona também para contas criadas com o Google e sua senha não é digitada no Revit."
                       FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="8,8,8,0"/>

            <Grid Margin="0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Rectangle Height="1" Fill="{StaticResource BorderSubtle}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="ou" Margin="12,0" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                <Rectangle Grid.Column="2" Height="1" Fill="{StaticResource BorderSubtle}" VerticalAlignment="Center"/>
            </Grid>

            <Button Style="{StaticResource SecondaryButton}" Height="40" Content="Entrar com e-mail e senha"
                    Command="{Binding ShowPasswordCommand}"/>
        </StackPanel>

        <!-- ══ Step 2: browser waiting ══ -->
        <StackPanel Visibility="{Binding IsBrowserStep, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Confirme no site se o código abaixo é o mesmo e clique em Autorizar."
                       Style="{StaticResource BodyText}" TextAlignment="Center"/>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="16,18">
                <TextBlock Text="{Binding UserCode}" FontFamily="Consolas" FontSize="32" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
            </Border>

            <ProgressBar Style="{StaticResource ThinProgress}" IsIndeterminate="True" Margin="0,18,0,0"/>
            <TextBlock Text="Aguardando autorização no navegador…" FontSize="12.5"
                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Text="{Binding CountdownText}" FontSize="11.5"
                       Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource SecondaryButton}" Content="Cancelar" Command="{Binding CancelBrowserCommand}"/>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Abrir o site novamente"
                        Command="{Binding ReopenBrowserCommand}"/>
            </Grid>
        </StackPanel>

        <!-- ══ Step 3: e-mail and password ══ -->
        <StackPanel Visibility="{Binding IsPasswordStep, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="E-mail" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
            <TextBox x:Name="EmailBox" Style="{StaticResource InputTextBox}" Tag="voce@exemplo.com"
                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>

            <Grid Margin="0,14,0,6">
                <TextBlock Text="Senha" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                <Button Style="{StaticResource LinkButton}" Content="Esqueci minha senha" HorizontalAlignment="Right"
                        FontSize="12" Command="{Binding ForgotPasswordCommand}"/>
            </Grid>
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource InputPasswordBox}"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"/>

            <Button Style="{StaticResource PrimaryButton}" Height="42" Margin="0,20,0,0" IsDefault="True"
                    Command="{Binding PasswordSignInCommand}">
                <Grid>
                    <TextBlock Text="Entrar" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                    <TextBlock Text="Entrando…" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Button>

            <Button Style="{StaticResource LinkButton}" Content="← Voltar" HorizontalAlignment="Center"
                    Margin="0,14,0,0" Command="{Binding BackCommand}"/>
        </StackPanel>

        <!-- Footer -->
        <Rectangle Height="1" Fill="{StaticResource BorderSubtle}" Margin="0,24,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Ainda não tem conta? " FontSize="12.5" Foreground="{StaticResource TextSecondary}"/>
            <Button Style="{StaticResource LinkButton}" Content="Criar conta no site" Command="{Binding RegisterCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
