<Window x:Class="UnSetBim.Framework.Updates.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UnSetBim.Framework.Updates"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:UpdateViewModel}"
        Title="UnSet BIM — Atualização"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UnSetBim.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="28,24,28,22">
        <TextBlock Text="{Binding Title}" Style="{StaticResource TitleText}" FontSize="18"/>
        <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyText}" Margin="0,8,0,0"/>

        <TextBlock Text="NOVIDADES" Style="{StaticResource SectionLabel}" Margin="0,18,0,8"/>
        <Border Style="{StaticResource Card}" Padding="14,12" MaxHeight="220">
            <ScrollViewer Style="{StaticResource MinimalScrollViewer}" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding Notes}" Style="{StaticResource BodyText}" FontSize="12.5"/>
            </ScrollViewer>
        </Border>

        <Border Style="{StaticResource ErrorBanner}" Margin="0,14,0,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVis}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Danger}" FontSize="12.5" TextWrapping="Wrap"/>
        </Border>

        <!-- Offer -->
        <StackPanel Visibility="{Binding IsOfferStep, Converter={StaticResource BoolToVis}}" Margin="0,18,0,0">
            <TextBlock Style="{StaticResource BodyText}" FontSize="12" Foreground="{StaticResource TextMuted}"
                       Visibility="{Binding CannotDownload, Converter={StaticResource BoolToVis}}"
                       Text="Esta versão não pode ser instalada pelo plugin. Baixe o instalador pela página da versão."/>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource LinkButton}" Content="Ver no GitHub" VerticalAlignment="Center"
                        Command="{Binding OpenReleaseCommand}"/>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="{Binding CloseText}"
                        Command="{Binding CloseCommand}" IsCancel="True"/>
                <Button Grid.Column="4" Style="{StaticResource PrimaryButton}" Command="{Binding DownloadCommand}"
                        Visibility="{Binding CanDownload, Converter={StaticResource BoolToVis}}">
                    <TextBlock>
                        <Run Text="Baixar atualização"/>
                        <Run Text="{Binding SizeText, Mode=OneWay}" Foreground="#CCFFFFFF" FontWeight="Normal"/>
                    </TextBlock>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Downloading -->
        <StackPanel Visibility="{Binding IsDownloadingStep, Converter={StaticResource BoolToVis}}" Margin="0,18,0,0">
            <ProgressBar Style="{StaticResource ThinProgress}" Height="6" Maximum="100" Value="{Binding Progress, Mode=OneWay}"/>
            <TextBlock Text="{Binding StatusText}" FontSize="12.5"
                       Foreground="{StaticResource TextSecondary}" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- Ready -->
        <StackPanel Visibility="{Binding IsReadyStep, Converter={StaticResource BoolToVis}}" Margin="0,18,0,0">
            <Border Style="{StaticResource InfoBanner}">
                <TextBlock Foreground="{StaticResource TextPrimary}" FontSize="12.5" TextWrapping="Wrap"
                           Text="{Binding InstalledText}"/>
            </Border>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Depois"
                        Command="{Binding CloseCommand}" IsCancel="True"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Fechar o Revit agora" Margin="10,0,0,0"
                        Command="{Binding ExitRevitCommand}"/>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
