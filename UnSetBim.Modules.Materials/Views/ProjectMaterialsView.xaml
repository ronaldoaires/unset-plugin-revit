<UserControl x:Class="UnSetBim.Modules.Materials.Views.ProjectMaterialsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UnSetBim.Modules.Materials.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MaterialEditorViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Merged here too: StaticResource lookups happen before the control joins the window. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UnSetBim.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="FieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                <Setter Property="Margin" Value="0,0,0,5"/>
            </Style>

            <Style x:Key="NumberBox" TargetType="TextBox" BasedOn="{StaticResource InputTextBox}">
                <Setter Property="Width" Value="110"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>

            <Style x:Key="Section" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BgCard}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Height" Value="30"/>
                <Setter Property="MinHeight" Value="30"/>
                <Setter Property="Padding" Value="10,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>

            <Style x:Key="EditorSlider" TargetType="Slider">
                <Setter Property="Width" Value="220"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="IsMoveToPointEnabled" Value="True"/>
            </Style>

            <Style x:Key="EditorCheck" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style x:Key="StatusLine" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Material picker and local actions (no server calls) ── -->
        <Border Background="{StaticResource BgToolbar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
                Padding="10,10,10,8">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="↻" Margin="6,0,0,0" Width="32" Padding="0"
                            ToolTip="Atualizar a lista (troque de projeto e clique aqui)" Command="{Binding RefreshCommand}"/>
                    <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding Materials}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}" DisplayMemberPath="Name" MaxDropDownHeight="400"
                              ToolTip="Materiais do UnSet BIM neste projeto"/>
                </DockPanel>

                <TextBlock Text="{Binding ListMessage}" Style="{StaticResource BodyText}" FontSize="12" TextWrapping="Wrap" Margin="2,6,0,0"
                           Visibility="{Binding ListMessage, Converter={StaticResource HasValueToVis}}"/>

                <WrapPanel Margin="0,8,0,0">
                    <Button Style="{StaticResource SmallButton}" Content="Pintar faces" Margin="0,0,6,6"
                            Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Foreground="White"
                            ToolTip="Pinta as faces que você clicar com ESTE material (ou variação). Esc termina."
                            Command="{Binding PaintCommand}"/>
                    <Button Style="{StaticResource SmallButton}" Content="Criar variação" Margin="0,0,6,6"
                            ToolTip="Copia este material com ajustes próprios (outro ângulo, escala ou acabamento). Usa as mesmas imagens, sem baixar nada."
                            Command="{Binding CreateVariantCommand}"/>
                    <Button Style="{StaticResource SmallButton}" Content="Escolher pela face" Margin="0,0,6,6"
                            ToolTip="Clique numa face do modelo para abrir o material dela aqui."
                            Command="{Binding PickFromFaceCommand}"/>
                    <Button Style="{StaticResource SmallButton}" Content="Remover pintura" Margin="0,0,6,6"
                            ToolTip="Clique nas faces pintadas para tirar o material (a face volta ao material do elemento). Esc termina."
                            Command="{Binding RemovePaintCommand}"/>
                    <Button Style="{StaticResource SmallButton}" Content="Excluir material" Margin="0,0,6,6"
                            ToolTip="Apaga este material do projeto. Pede confirmação."
                            Command="{Binding DeleteMaterialCommand}"/>
                </WrapPanel>

                <TextBlock Text="{Binding Status}" Style="{StaticResource StatusLine}" TextWrapping="Wrap" Margin="2,2,0,0"
                           Visibility="{Binding Status, Converter={StaticResource HasValueToVis}}"/>
            </StackPanel>
        </Border>

        <!-- ── Editor ── -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource MinimalScrollViewer}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding HasSettings, Converter={StaticResource BoolToVis}}">
            <StackPanel Margin="10,12,10,12">

                <!-- Preview: 2 m × 2 m, tiled like the model -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,12">
                    <Border Width="{Binding PreviewSquare}" Height="{Binding PreviewSquare}" CornerRadius="8" ClipToBounds="True"
                            BorderBrush="{StaticResource BorderMid}" BorderThickness="1" Background="#1F1F24">
                        <Grid>
                            <Rectangle>
                                <Rectangle.Fill>
                                    <ImageBrush ImageSource="{Binding DiffuseImage}" TileMode="Tile" Stretch="Fill"
                                                ViewportUnits="Absolute" Viewport="{Binding PreviewViewport}"
                                                Transform="{Binding PreviewTransform}"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle Fill="{Binding TintBrush}" Opacity="0.35"
                                       Visibility="{Binding TintEnabled, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                    <TextBlock Text="Prévia de 2 × 2 m · resultado final no estilo Realista" FontSize="11" Foreground="{StaticResource TextMuted}"
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Size -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="ESCALA (UMA REPETIÇÃO)" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="Largura (mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource NumberBox}" Width="100" Text="{Binding WidthMm, StringFormat='0.#'}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="Altura (mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource NumberBox}" Width="100" Text="{Binding HeightMm, StringFormat='0.#'}"/>
                            </StackPanel>
                        </WrapPanel>
                        <CheckBox Style="{StaticResource EditorCheck}" Content="Manter proporção" IsChecked="{Binding KeepRatio}"/>
                        <Button Style="{StaticResource SmallButton}" Content="Tamanho original" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding ResetSizeCommand}"
                                ToolTip="{Binding OriginalSizeText}"/>
                    </StackPanel>
                </Border>

                <!-- Rotation and position -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="ROTAÇÃO E POSIÇÃO" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <TextBlock Text="Rotação (graus)" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <TextBox DockPanel.Dock="Right" Style="{StaticResource NumberBox}" Width="64" Margin="8,0,0,0"
                                     Text="{Binding RotationDeg, StringFormat='0.#'}"/>
                            <Slider Style="{StaticResource EditorSlider}" Width="Auto" Minimum="-180" Maximum="180"
                                    TickFrequency="15" IsSnapToTickEnabled="True" Value="{Binding RotationDeg}"/>
                        </DockPanel>

                        <WrapPanel Margin="0,10,0,0">
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="Deslocamento X (mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource NumberBox}" Width="100" Text="{Binding OffsetXMm, StringFormat='0.#'}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,10,6">
                                <TextBlock Text="Deslocamento Y (mm)" Style="{StaticResource FieldLabel}"/>
                                <TextBox Style="{StaticResource NumberBox}" Width="100" Text="{Binding OffsetYMm, StringFormat='0.#'}"/>
                            </StackPanel>
                        </WrapPanel>

                        <!-- Arrows move a tenth of the tile -->
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SmallButton}" Content="←" Width="34" Padding="0"
                                    ToolTip="Mover para a esquerda" Command="{Binding NudgeCommand}" CommandParameter="left"/>
                            <Button Style="{StaticResource SmallButton}" Content="↑" Width="34" Padding="0"
                                    ToolTip="Mover para cima" Command="{Binding NudgeCommand}" CommandParameter="up"/>
                            <Button Style="{StaticResource SmallButton}" Content="↓" Width="34" Padding="0"
                                    ToolTip="Mover para baixo" Command="{Binding NudgeCommand}" CommandParameter="down"/>
                            <Button Style="{StaticResource SmallButton}" Content="→" Width="34" Padding="0"
                                    ToolTip="Mover para a direita" Command="{Binding NudgeCommand}" CommandParameter="right"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Look -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="APARÊNCIA" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>

                        <TextBlock Text="Brilho da imagem" Style="{StaticResource FieldLabel}"/>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ImageBrightness, StringFormat='0.00'}" Width="40"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextAlignment="Right"/>
                            <Slider Style="{StaticResource EditorSlider}" Width="Auto" Minimum="0.2" Maximum="2" Value="{Binding ImageBrightness}"/>
                        </DockPanel>

                        <StackPanel Visibility="{Binding HasRelief, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                            <TextBlock Text="Relevo" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding ReliefAmount, StringFormat='0.00'}" Width="40"
                                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextAlignment="Right"/>
                                <Slider Style="{StaticResource EditorSlider}" Width="Auto" Minimum="0" Maximum="3" Value="{Binding ReliefAmount}"/>
                            </DockPanel>
                        </StackPanel>

                        <TextBlock Text="Acabamento" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                        <WrapPanel>
                            <Button Style="{StaticResource SmallButton}" Content="Mapa da textura" Margin="0,0,6,6"
                                    Command="{Binding PresetCommand}" CommandParameter="map"
                                    ToolTip="Usa o mapa de rugosidade da textura (partes foscas e brilhantes)."
                                    Visibility="{Binding RoughnessAvailable, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource SmallButton}" Content="Fosco" Margin="0,0,6,6" Command="{Binding PresetCommand}" CommandParameter="matte"/>
                            <Button Style="{StaticResource SmallButton}" Content="Acetinado" Margin="0,0,6,6" Command="{Binding PresetCommand}" CommandParameter="satin"/>
                            <Button Style="{StaticResource SmallButton}" Content="Brilhante" Margin="0,0,6,6" Command="{Binding PresetCommand}" CommandParameter="gloss"/>
                            <Button Style="{StaticResource SmallButton}" Content="Polido" Margin="0,0,6,6" Command="{Binding PresetCommand}" CommandParameter="polished"/>
                        </WrapPanel>
                        <DockPanel IsEnabled="{Binding CanEditGlossiness}">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Glossiness, StringFormat='0.00'}" Width="40"
                                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" TextAlignment="Right"/>
                            <Slider Style="{StaticResource EditorSlider}" Width="Auto" Minimum="0" Maximum="1" Value="{Binding Glossiness}"/>
                        </DockPanel>
                        <TextBlock Text="Usando o mapa de rugosidade da textura." FontSize="11" Foreground="{StaticResource TextMuted}"
                                   Margin="0,4,0,0" Visibility="{Binding UseRoughnessMap, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Tint -->
                <Border Style="{StaticResource Section}">
                    <StackPanel>
                        <TextBlock Text="TINGIR" Style="{StaticResource SectionLabel}" Margin="0,0,0,8"/>
                        <CheckBox Style="{StaticResource EditorCheck}" Content="Tingir a textura com uma cor" IsChecked="{Binding TintEnabled}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Width="28" Height="28" CornerRadius="6" Background="{Binding TintBrush}"
                                    BorderBrush="{StaticResource BorderMid}" BorderThickness="1"/>
                            <TextBox Style="{StaticResource NumberBox}" Width="96" Margin="8,0,0,0"
                                     Text="{Binding TintColor}" ToolTip="Cor em hexadecimal, ex.: #d9b38c"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding TintSwatches}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="22" Height="22" Margin="0,0,5,5" Cursor="Hand" ToolTip="{Binding}"
                                            Command="{Binding DataContext.TintSwatchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border CornerRadius="11" Background="{Binding}" BorderBrush="{StaticResource BorderMid}" BorderThickness="1"/>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="2,0,0,0"
                           Text="Os ajustes valem para todas as faces com este material. Para outro ângulo ou acabamento em outra parte, use &quot;Criar variação&quot;. Cada ajuste é um Ctrl+Z no Revit."/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
