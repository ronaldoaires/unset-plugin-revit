<Window x:Class="UnSetBim.Modules.Materials.Views.TexturesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="https://unset.com.br/ui"
        xmlns:vm="clr-namespace:UnSetBim.Modules.Materials.ViewModels"
        xmlns:views="clr-namespace:UnSetBim.Modules.Materials.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:TexturesViewModel}"
        Title="UnSet BIM — Texturas"
        Width="1240" Height="820"
        MinWidth="980" MinHeight="620">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UnSetBim.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="NavListItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,8" Margin="0,1">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Card as a button: click selects (and shows the action bar) -->
            <Style x:Key="CardButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="2" CornerRadius="10" ClipToBounds="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgCardHover}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Free = green, subscribers = amber (same colors as the families catalog) -->
            <Style x:Key="AccessBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="Background" Value="#B45309"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35" Color="Black"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFree}" Value="True">
                        <Setter Property="Background" Value="#16A34A"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SubscribeButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Background" Value="#B45309"/>
                <Setter Property="BorderBrush" Value="#B45309"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#C9650F"/>
                        <Setter Property="BorderBrush" Value="#C9650F"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="StatusText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════ HEADER ════ -->
        <Border Background="{StaticResource BgToolbar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource LogoMark}">
                        <TextBlock Text="U" FontWeight="Bold" FontSize="15" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="UnSet BIM" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Texturas e materiais" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource TabRadio}" GroupName="Tabs" Content="Biblioteca"
                                 IsChecked="{Binding IsLibraryTab, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource TabRadio}" GroupName="Tabs" Content="No projeto" Margin="4,0,0,0"
                                 ToolTip="Materiais do UnSet BIM neste projeto: ajuste escala, rotação, posição, relevo, brilho e cor."
                                 IsChecked="{Binding IsProjectTab, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding UserName}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"
                                   MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding AccessText}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource Accent}">
                        <TextBlock Text="{Binding UserName, Converter={StaticResource Initial}}" FontWeight="Bold" FontSize="13"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════ PROJECT TAB ════ -->
        <views:ProjectMaterialsView Grid.Row="1" DataContext="{Binding Project}"
                                    Visibility="{Binding DataContext.IsProjectTab, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

        <!-- ════ BODY (library tab) ════ -->
        <Grid Grid.Row="1" Visibility="{Binding IsLibraryTab, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── SIDEBAR ── -->
            <Border Background="{StaticResource BgToolbar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,18,12,12">
                    <TextBlock DockPanel.Dock="Top" Text="CATEGORIAS" Style="{StaticResource SectionLabel}" Margin="12,0,0,10"/>
                    <ListBox ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavListItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox">
                                <ScrollViewer Style="{StaticResource MinimalScrollViewer}" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TextureNavItem}">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- ── MAIN ── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Margin="24,20,20,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{Binding ListTitle}" Style="{StaticResource TitleText}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Margin="0,3,0,0" FontSize="12.5" Foreground="{StaticResource TextMuted}"
                                   Text="Clique numa textura e escolha: pintar faces do modelo ou só criar o material, já no tamanho real."/>
                    </StackPanel>

                    <!-- Filters -->
                    <Grid Grid.Row="1" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBox}"
                                 Tag="Buscar textura   (Ctrl+F)"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Grid.Column="2" Style="{StaticResource DarkComboBox}" ToolTip="Tipo de material"
                                  ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding SelectedType, Mode=TwoWay}"
                                  DisplayMemberPath="Label"/>
                        <ComboBox Grid.Column="4" Style="{StaticResource DarkComboBox}" ToolTip="Acesso"
                                  ItemsSource="{Binding AccessOptions}" SelectedItem="{Binding SelectedAccess, Mode=TwoWay}"
                                  DisplayMemberPath="Label"/>
                        <ComboBox Grid.Column="6" Style="{StaticResource DarkComboBox}" ToolTip="Ordenar por"
                                  ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                                  DisplayMemberPath="Label"/>
                        <Button Grid.Column="7" Style="{StaticResource LinkButton}" Content="Limpar" Margin="14,0,0,0"
                                VerticalAlignment="Center" Command="{Binding ClearFiltersCommand}"
                                Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"/>
                    </Grid>

                    <!-- Results -->
                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <ProgressBar Style="{StaticResource ThinProgress}" IsIndeterminate="True" VerticalAlignment="Top"
                                     Margin="0,-10,0,0" Height="3"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                        <ScrollViewer x:Name="ResultsScroll" Style="{StaticResource MinimalScrollViewer}"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Textures}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid VerticalAlignment="Top"
                                                     Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource WidthToColumns}, ConverterParameter=190}"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TextureCardViewModel}">
                                        <Button Style="{StaticResource CardButton}" Margin="0,0,14,14"
                                                Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <DockPanel>
                                                <!-- Square swatch: the texture fills it -->
                                                <Grid DockPanel.Dock="Top" Height="170" Background="#1F1F24">
                                                    <TextBlock Text="▦" FontSize="34" Foreground="#3F3F46"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    <Image ui:RemoteImage.Url="{Binding ThumbnailUrl}" ui:RemoteImage.DecodeWidth="400"
                                                           Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <Border Style="{StaticResource AccessBadge}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                                        <TextBlock Text="{Binding BadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Margin="12,10,12,12">
                                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding SizeText, Mode=OneWay}"/>
                                                        <Run Text=" · "/>
                                                        <Run Text="{Binding TypeText, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="⊘" FontSize="40" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Nenhuma textura encontrada" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            <TextBlock Text="{Binding EmptyText}" FontSize="12.5" Foreground="{StaticResource TextMuted}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>

                        <!-- Error -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVis}}">
                            <TextBlock Text="Não foi possível carregar" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource BodyText}" TextAlignment="Center" Margin="0,8,0,0"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="↻  Tentar novamente" HorizontalAlignment="Center"
                                    Margin="0,16,0,0" Command="{Binding RetryCommand}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Pagination -->
                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <TextBlock Text="{Binding PageText}" FontSize="12.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource PaginationButton}" Content="‹" FontSize="16" ToolTip="Página anterior"
                                    Command="{Binding PreviousPageCommand}"/>
                            <Button Style="{StaticResource PaginationButton}" Content="›" FontSize="16" ToolTip="Próxima página" Margin="8,0,0,0"
                                    Command="{Binding NextPageCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ════ ACTION BAR (selected texture) ════ -->
                <Border Grid.Row="1" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderMid}" BorderThickness="0,1,0,0"
                        Padding="24,14,20,14"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="64" Height="64" CornerRadius="8" ClipToBounds="True" Background="#1F1F24"
                                DataContext="{Binding Selected}">
                            <Image ui:RemoteImage.Url="{Binding ThumbnailUrl}" ui:RemoteImage.DecodeWidth="200" Stretch="UniformToFill"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Selected.Name}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                <Run Text="Repetição de "/>
                                <Run Text="{Binding Selected.SizeText, Mode=OneWay}"/>
                                <Run Text=" · "/>
                                <Run Text="{Binding Selected.TypeText, Mode=OneWay}"/>
                            </TextBlock>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" Margin="0,6,0,0"
                                       Visibility="{Binding StatusText, Converter={StaticResource HasValueToVis}}"/>
                            <ProgressBar Style="{StaticResource ThinProgress}" Height="3" Margin="0,6,0,0" Maximum="1"
                                         Value="{Binding Progress, Mode=OneWay}"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource LinkButton}" Content="Ajustar material →" Margin="0,0,6,0"
                                    VerticalAlignment="Center" Command="{Binding AdjustCommand}"
                                    ToolTip="Abre o material na aba No projeto para mudar escala, rotação, posição, relevo, brilho e cor."
                                    Visibility="{Binding CanAdjust, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource SubscribeButton}" Content="Assinar para usar"
                                    Command="{Binding SubscribeCommand}"
                                    Visibility="{Binding ShowSubscribe, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource SecondaryButton}" Content="Só criar material" Margin="10,0,0,0"
                                    ToolTip="Cria o material no projeto, sem pintar nada. Use depois pelo Navegador de materiais."
                                    Command="{Binding CreateOnlyCommand}"
                                    Visibility="{Binding Selected.IsLocked, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Pintar faces" Margin="10,0,0,0"
                                    ToolTip="Cria o material e pinta as faces que você clicar no Revit. Esc termina."
                                    Command="{Binding PaintCommand}"
                                    Visibility="{Binding Selected.IsLocked, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                            <Button Style="{StaticResource GhostButton}" Content="✕" Margin="10,0,0,0" ToolTip="Fechar (Esc)"
                                    Command="{Binding CloseSelectionCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
