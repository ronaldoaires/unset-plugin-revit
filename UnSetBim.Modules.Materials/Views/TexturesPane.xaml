<UserControl x:Class="UnSetBim.Modules.Materials.Views.TexturesPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="https://unset.com.br/ui"
             xmlns:vm="clr-namespace:UnSetBim.Modules.Materials.ViewModels"
             xmlns:views="clr-namespace:UnSetBim.Modules.Materials.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="340" d:DesignHeight="760"
             Background="{DynamicResource BgBase}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UnSetBim.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Card as a button: click selects it and shows the action bar -->
            <Style x:Key="CardButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="2" CornerRadius="8" ClipToBounds="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgCardHover}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Free = green, subscribers = amber (same colors as the families catalog) -->
            <Style x:Key="AccessBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="4"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="Background" Value="#B45309"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFree}" Value="True">
                        <Setter Property="Background" Value="#16A34A"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SubscribeButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Background" Value="#B45309"/>
                <Setter Property="BorderBrush" Value="#B45309"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#C9650F"/>
                        <Setter Property="BorderBrush" Value="#C9650F"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Margin" Value="0,6,6,0"/>
            </Style>
            <Style x:Key="BarSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                <Setter Property="Height" Value="32"/>
                <Setter Property="MinHeight" Value="32"/>
                <Setter Property="Padding" Value="12,0"/>
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Margin" Value="0,6,6,0"/>
            </Style>

            <Style x:Key="StatusText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource Warning}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Filter icon: Tag = filter active (accent color) -->
            <Style x:Key="FilterIcon" TargetType="Button">
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="6,0,0,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource BgInput}" BorderBrush="{StaticResource BorderMid}"
                                    BorderThickness="1" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentLight}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Dark filter menus -->
            <Style x:Key="FilterMenu" TargetType="ContextMenu">
                <Setter Property="Placement" Value="Bottom"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContextMenu">
                            <Border Background="{StaticResource BgElevated}" BorderBrush="{StaticResource BorderMid}" BorderThickness="1"
                                    CornerRadius="8" Padding="4" MinWidth="180">
                                <ScrollViewer Style="{StaticResource MinimalScrollViewer}" MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="FilterMenuItem" TargetType="MenuItem">
                <Setter Property="Header" Value="{Binding Label}"/>
                <Setter Property="CommandParameter" Value="{Binding}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="MenuItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                               Width="18" VerticalAlignment="Center" Foreground="{StaticResource AccentLight}" Visibility="Hidden"/>
                                    <TextBlock Text="{TemplateBinding Header}" FontSize="12.5" Foreground="{StaticResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- ════ SIGNED OUT ════ -->
        <StackPanel x:Name="SignedOutPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="280">
            <Border Style="{StaticResource LogoMark}" HorizontalAlignment="Center">
                <TextBlock Text="U" FontWeight="Bold" FontSize="15" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Texturas do UnSet BIM" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                       HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock Text="Entre na sua conta para ver as texturas e criar materiais no tamanho real."
                       Style="{StaticResource BodyText}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <Button Style="{StaticResource PrimaryButton}" Content="Entrar" HorizontalAlignment="Center" Margin="0,16,0,0"
                    Click="OnSignInClick"/>
        </StackPanel>

        <!-- ════ MAIN ════ -->
        <Grid x:Name="MainContent" Visibility="Collapsed" d:DataContext="{d:DesignInstance Type=vm:TexturesViewModel}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tabs + access -->
            <Border Background="{StaticResource BgToolbar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1"
                    Padding="10,8">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <RadioButton Style="{StaticResource TabRadio}" GroupName="TexturesTabs" Content="Biblioteca"
                                     IsChecked="{Binding IsLibraryTab, Mode=TwoWay}"/>
                        <RadioButton Style="{StaticResource TabRadio}" GroupName="TexturesTabs" Content="No projeto" Margin="4,0,0,0"
                                     ToolTip="Materiais do UnSet BIM neste projeto: ajuste, crie variações e pinte."
                                     IsChecked="{Binding IsProjectTab, Mode=TwoWay}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AccessText}" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"
                               ToolTip="{Binding UserName}"/>
                </DockPanel>
            </Border>

            <!-- ════ PROJECT TAB ════ -->
            <views:ProjectMaterialsView Grid.Row="1" DataContext="{Binding Project}"
                                        Visibility="{Binding DataContext.IsProjectTab, ElementName=MainContent, Converter={StaticResource BoolToVis}}"/>

            <!-- ════ LIBRARY TAB ════ -->
            <Grid Grid.Row="1" Visibility="{Binding IsLibraryTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Search + filter icons (each icon opens a menu; the tooltip says the current value) -->
                <DockPanel Margin="10,10,10,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource FilterIcon}" Content="&#xE894;" ToolTip="Limpar filtros"
                            Command="{Binding ClearFiltersCommand}"
                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"/>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FilterIcon}" Content="&#xE8CB;"
                            ToolTip="{Binding SortTip}" Click="OnFilterButtonClick">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource FilterMenu}" ItemsSource="{Binding SortOptions}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource FilterMenuItem}">
                                        <Setter Property="Command" Value="{Binding DataContext.SelectSortCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FilterIcon}" Content="&#xE72E;"
                            ToolTip="{Binding AccessTip}" Tag="{Binding IsAccessFiltered}" Click="OnFilterButtonClick">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource FilterMenu}" ItemsSource="{Binding AccessOptions}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource FilterMenuItem}">
                                        <Setter Property="Command" Value="{Binding DataContext.SelectAccessCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FilterIcon}" Content="&#xE790;"
                            ToolTip="{Binding TypeTip}" Tag="{Binding IsTypeFiltered}" Click="OnFilterButtonClick">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource FilterMenu}" ItemsSource="{Binding TypeOptions}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource FilterMenuItem}">
                                        <Setter Property="Command" Value="{Binding DataContext.SelectTypeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FilterIcon}" Content="&#xE8B7;"
                            ToolTip="{Binding CategoryTip}" Tag="{Binding IsCategoryFiltered}" Click="OnFilterButtonClick">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource FilterMenu}" ItemsSource="{Binding NavItems}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource FilterMenuItem}">
                                        <Setter Property="Command" Value="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <TextBox Style="{StaticResource InputTextBox}" Tag="Buscar textura" Height="34"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>

                <!-- Results -->
                <Grid Grid.Row="1" Margin="10,0,4,0">
                    <ProgressBar Style="{StaticResource ThinProgress}" IsIndeterminate="True" VerticalAlignment="Top" Height="3"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                    <ScrollViewer x:Name="ResultsScroll" Style="{StaticResource MinimalScrollViewer}" Margin="0,6,0,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Textures}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <!-- Narrow pane: 2 columns at ~300 px, more when it is wider. -->
                                    <UniformGrid VerticalAlignment="Top"
                                                 Columns="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}, Converter={StaticResource WidthToColumns}, ConverterParameter=128}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:TextureCardViewModel}">
                                    <Button Style="{StaticResource CardButton}" Margin="0,0,8,8"
                                            Command="{Binding DataContext.SelectCommand, ElementName=MainContent}"
                                            CommandParameter="{Binding}" ToolTip="{Binding Name}">
                                        <DockPanel>
                                            <Grid DockPanel.Dock="Top" Height="112" Background="#1F1F24">
                                                <TextBlock Text="▦" FontSize="26" Foreground="#3F3F46"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image ui:RemoteImage.Url="{Binding ThumbnailUrl}" ui:RemoteImage.DecodeWidth="300"
                                                       Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Border Style="{StaticResource AccessBadge}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                                                    <TextBlock Text="{Binding BadgeText}" FontSize="8.5" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                            <StackPanel Margin="8,6,8,8">
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Nenhuma textura encontrada" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EmptyText}" FontSize="12" Foreground="{StaticResource TextMuted}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVis}}">
                        <TextBlock Text="Não foi possível carregar" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource BodyText}" TextAlignment="Center"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="↻  Tentar novamente" HorizontalAlignment="Center"
                                Margin="0,12,0,0" Command="{Binding RetryCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Pagination -->
                <Grid Grid.Row="2" Margin="10,4,10,8">
                    <TextBlock Text="{Binding PageText}" FontSize="11.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource PaginationButton}" Content="‹" FontSize="15" ToolTip="Página anterior"
                                Command="{Binding PreviousPageCommand}"/>
                        <Button Style="{StaticResource PaginationButton}" Content="›" FontSize="15" ToolTip="Próxima página" Margin="6,0,0,0"
                                Command="{Binding NextPageCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- ════ ACTION BAR (selected texture) ════ -->
                <Border Grid.Row="3" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderMid}" BorderThickness="0,1,0,0"
                        Padding="10,10,10,10"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="6" ClipToBounds="True" Background="#1F1F24"
                                    DataContext="{Binding Selected}">
                                <Image ui:RemoteImage.Url="{Binding ThumbnailUrl}" ui:RemoteImage.DecodeWidth="120" Stretch="UniformToFill"/>
                            </Border>
                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="✕" VerticalAlignment="Top"
                                    ToolTip="Fechar" Command="{Binding CloseSelectionCommand}"/>
                            <StackPanel Margin="10,0,4,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Selected.Name}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Selected.SizeText, Mode=OneWay}"/>
                                    <Run Text=" · "/>
                                    <Run Text="{Binding Selected.TypeText, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource StatusText}" Margin="0,8,0,0"
                                   Visibility="{Binding StatusText, Converter={StaticResource HasValueToVis}}"/>
                        <ProgressBar Style="{StaticResource ThinProgress}" Height="3" Margin="0,6,0,0" Maximum="1"
                                     Value="{Binding Progress, Mode=OneWay}"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

                        <WrapPanel Margin="0,4,0,0">
                            <Button Style="{StaticResource BarButton}" Content="Pintar faces"
                                    ToolTip="Cria (ou reaproveita) o material e pinta as faces que você clicar. Esc termina."
                                    Command="{Binding PaintCommand}"
                                    Visibility="{Binding Selected.IsLocked, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                            <Button Style="{StaticResource BarSecondaryButton}" Content="Só criar"
                                    ToolTip="Cria o material no projeto sem pintar nada."
                                    Command="{Binding CreateOnlyCommand}"
                                    Visibility="{Binding Selected.IsLocked, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                            <Button Style="{StaticResource BarSecondaryButton}" Content="Ajustar →"
                                    ToolTip="Abre o material na aba No projeto: escala, rotação, variações..."
                                    Command="{Binding AdjustCommand}"
                                    Visibility="{Binding CanAdjust, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource SubscribeButton}" Content="Assinar para usar" Margin="0,6,6,0"
                                    Command="{Binding SubscribeCommand}"
                                    Visibility="{Binding ShowSubscribe, Converter={StaticResource BoolToVis}}"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
