<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- UnSet BIM palette. Dark theme matching the Revit dark UI. -->

    <!-- Neutral scale -->
    <Color x:Key="ColorBgBase">#0E0E12</Color>
    <SolidColorBrush x:Key="BgBase"          Color="{StaticResource ColorBgBase}"/>
    <SolidColorBrush x:Key="BgSurface"       Color="#15151B"/>
    <SolidColorBrush x:Key="BgToolbar"       Color="#121218"/>
    <SolidColorBrush x:Key="BgCard"          Color="#1B1B22"/>
    <SolidColorBrush x:Key="BgCardHover"     Color="#22222B"/>
    <SolidColorBrush x:Key="BgElevated"      Color="#24242D"/>
    <SolidColorBrush x:Key="BgInput"         Color="#18181F"/>
    <SolidColorBrush x:Key="BgOverlay"       Color="#B30E0E12"/>
    <SolidColorBrush x:Key="BgHover"         Color="#14FFFFFF"/>

    <SolidColorBrush x:Key="BorderSubtle"    Color="#2A2A34"/>
    <SolidColorBrush x:Key="BorderMid"       Color="#3A3A46"/>
    <SolidColorBrush x:Key="BorderStrong"    Color="#52525F"/>

    <SolidColorBrush x:Key="TextPrimary"     Color="#F2F2F4"/>
    <SolidColorBrush x:Key="TextSecondary"   Color="#A1A1AE"/>
    <SolidColorBrush x:Key="TextMuted"       Color="#6E6E7E"/>

    <!-- Brand accent -->
    <SolidColorBrush x:Key="Accent"          Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentHover"     Color="#1A88E0"/>
    <SolidColorBrush x:Key="AccentPressed"   Color="#006AC0"/>
    <SolidColorBrush x:Key="AccentLight"     Color="#60B8FF"/>
    <SolidColorBrush x:Key="AccentDim"       Color="#1A0078D4"/>

    <!-- Semantic -->
    <SolidColorBrush x:Key="Success"         Color="#22C55E"/>
    <SolidColorBrush x:Key="SuccessDim"      Color="#1A22C55E"/>
    <SolidColorBrush x:Key="Warning"         Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningDim"      Color="#1AF59E0B"/>
    <SolidColorBrush x:Key="Danger"          Color="#F87171"/>
    <SolidColorBrush x:Key="DangerDim"       Color="#1AF87171"/>
    <SolidColorBrush x:Key="Premium"         Color="#A78BFA"/>
    <SolidColorBrush x:Key="PremiumDim"      Color="#1AA78BFA"/>

    <SolidColorBrush x:Key="ScrollThumb"      Color="#3A3A46"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#52525F"/>

    <LinearGradientBrush x:Key="LogoGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0A4FA8" Offset="0"/>
        <GradientStop Color="#0078D4" Offset="1"/>
    </LinearGradientBrush>
</ResourceDictionary>
