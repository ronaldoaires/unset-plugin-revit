<Window x:Class="UnSetBim.Modules.Families.Views.CatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="https://unset.com.br/ui"
        xmlns:vm="clr-namespace:UnSetBim.Modules.Families.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:CatalogViewModel}"
        Title="UnSet BIM — Famílias"
        Width="1320" Height="840"
        MinWidth="1040" MinHeight="640">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/UnSetBim.UI;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Sidebar entries -->
            <Style x:Key="NavListItem" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="12,8" Margin="0,1">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgHover}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Accent}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Card as a button (click opens the detail) -->
            <Style x:Key="CardButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgCardHover}"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrong}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Heart toggle -->
            <Style x:Key="HeartButton" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Width" Value="30"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="ToolTip" Value="Favoritar"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#B30E0E12" CornerRadius="15">
                                <TextBlock x:Name="Icon" Text="♡" FontSize="15" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#E60E0E12"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                    <Setter TargetName="Icon" Property="Text" Value="♥"/>
                                    <Setter TargetName="Icon" Property="Foreground" Value="#F87171"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="Chip" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BorderMid}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
            </Style>

            <!-- Solid badge: it sits on white product images, so it needs its own opaque background -->
            <Style x:Key="PriceBadge" TargetType="Border">
                <Setter Property="CornerRadius" Value="5"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="Background" Value="#7C3AED"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35" Color="Black"/>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding PriceKind}" Value="{x:Static vm:PriceKind.Free}">
                        <Setter Property="Background" Value="#16A34A"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding PriceKind}" Value="{x:Static vm:PriceKind.Paid}">
                        <Setter Property="Background" Value="#0078D4"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Purchase call to action: green, full width, impossible to miss -->
            <Style x:Key="BuyButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                <Setter Property="Background" Value="#16A34A"/>
                <Setter Property="BorderBrush" Value="#16A34A"/>
                <Setter Property="FontSize" Value="14"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#22B357"/>
                        <Setter Property="BorderBrush" Value="#22B357"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#15803D"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="MetaLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
            <Style x:Key="MetaValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12.5"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════ HEADER ════ -->
        <Border Background="{StaticResource BgToolbar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource LogoMark}">
                        <TextBlock Text="U" FontWeight="Bold" FontSize="15" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="UnSet BIM" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock Text="Biblioteca de famílias" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource TabRadio}" GroupName="Tabs" Content="Catálogo"
                                 IsChecked="{Binding IsCatalogTab, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource TabRadio}" GroupName="Tabs" Content="♡  Favoritos" Margin="4,0,0,0"
                                 IsChecked="{Binding IsFavoritesTab, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource TabRadio}" GroupName="Tabs" Content="Meus downloads" Margin="4,0,0,0"
                                 IsChecked="{Binding IsDownloadsTab, Mode=TwoWay}"/>
                </StackPanel>

                <!-- User + quota -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding UserName}" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Right"
                                   MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding QuotaText}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Border Width="32" Height="32" CornerRadius="16" Background="{StaticResource Accent}">
                        <TextBlock Text="{Binding UserName, Converter={StaticResource Initial}}" FontWeight="Bold" FontSize="13"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════ BODY ════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ── SIDEBAR ── -->
            <Border Background="{StaticResource BgToolbar}" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12,18,12,12">
                    <TextBlock DockPanel.Dock="Top" Text="CATEGORIAS" Style="{StaticResource SectionLabel}" Margin="12,0,0,10"/>

                    <Button DockPanel.Dock="Bottom" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left"
                            Content="Abrir biblioteca no site ↗" Command="{Binding OpenSiteCommand}"/>

                    <Grid>
                        <ListBox ItemsSource="{Binding NavItems}"
                                 SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource NavListItem}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="{Binding IsCatalogTab, Converter={StaticResource BoolToVis}}">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer Style="{StaticResource MinimalScrollViewer}" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:NavItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="Label" Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="11.5" Opacity="0.7" Margin="8,0,0,0"/>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSubcategory}" Value="True">
                                            <Setter TargetName="Label" Property="Margin" Value="14,0,0,0"/>
                                            <Setter TargetName="Label" Property="FontSize" Value="12.5"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="Categorias e filtros valem para o Catálogo."
                                   Style="{StaticResource BodyText}" FontSize="12" Margin="12,0"
                                   Visibility="{Binding IsCatalogTab, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- ── MAIN ── -->
            <Grid Grid.Column="1" Margin="24,20,20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <StackPanel>
                    <TextBlock Text="{Binding ListTitle}" Style="{StaticResource TitleText}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Margin="0,3,0,0" FontSize="12.5" Foreground="{StaticResource TextMuted}">
                        <Run Text="{Binding TotalText, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding RevitText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>

                <!-- Filters (catalog only) -->
                <Grid Grid.Row="1" Margin="0,16,0,0" Visibility="{Binding IsCatalogTab, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox" Style="{StaticResource InputTextBox}"
                             Tag="Buscar por nome, descrição ou tag   (Ctrl+F)"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                    <ComboBox Grid.Column="2" Style="{StaticResource DarkComboBox}" ToolTip="Marca"
                              ItemsSource="{Binding BrandOptions}" SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                              DisplayMemberPath="Label" MaxDropDownHeight="360"/>
                    <ComboBox Grid.Column="4" Style="{StaticResource DarkComboBox}" ToolTip="Preço"
                              ItemsSource="{Binding PriceOptions}" SelectedItem="{Binding SelectedPrice, Mode=TwoWay}"
                              DisplayMemberPath="Label"/>
                    <ComboBox Grid.Column="6" Style="{StaticResource DarkComboBox}" ToolTip="Ordenar por"
                              ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                              DisplayMemberPath="Label"/>
                    <Button Grid.Column="7" Style="{StaticResource LinkButton}" Content="Limpar" Margin="14,0,0,0"
                            VerticalAlignment="Center" Command="{Binding ClearFiltersCommand}"
                            Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <!-- Results -->
                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <ProgressBar Style="{StaticResource ThinProgress}" IsIndeterminate="True" VerticalAlignment="Top"
                                 Margin="0,-10,0,0" Height="3"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

                    <ScrollViewer x:Name="ResultsScroll" Style="{StaticResource MinimalScrollViewer}"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Opacity="1">
                        <ItemsControl ItemsSource="{Binding Families}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FamilyCardViewModel}">
                                    <Button Style="{StaticResource CardButton}" Width="214" Margin="0,0,14,14"
                                            Command="{Binding DataContext.SelectFamilyCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <Grid Height="160" Background="White">
                                                <TextBlock Text="▦" FontSize="34" Foreground="#D4D4D8"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                <Image ui:RemoteImage.Url="{Binding ThumbnailUrl}" ui:RemoteImage.DecodeWidth="430"
                                                       Stretch="Uniform" Margin="8,30,8,8" RenderOptions.BitmapScalingMode="HighQuality"/>

                                                <Border Style="{StaticResource PriceBadge}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10">
                                                    <TextBlock Text="{Binding BadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <Button Style="{StaticResource HeartButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8"
                                                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>

                                            <StackPanel Margin="12,10,12,12">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap"
                                                           MaxHeight="36" TextTrimming="CharacterEllipsis" LineHeight="18"/>
                                                <TextBlock Text="{Binding CategoryText}" FontSize="11.5" Foreground="{StaticResource TextMuted}"
                                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                                <WrapPanel Margin="0,8,0,0">
                                                    <Border Style="{StaticResource Chip}">
                                                        <TextBlock Text="{Binding RevitVersionText}" FontSize="10.5" Foreground="{StaticResource AccentLight}"/>
                                                    </Border>
                                                    <Border Style="{StaticResource Chip}"
                                                            Visibility="{Binding IsParametric, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="Paramétrica" FontSize="10.5" Foreground="{StaticResource TextSecondary}"/>
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Text="{Binding HistoryText}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"
                                                           Visibility="{Binding HistoryText, Converter={StaticResource HasValueToVis}}"/>
                                                <TextBlock Text="Requer uma versão mais nova do Revit" FontSize="11" Foreground="{StaticResource Warning}" Margin="0,6,0,0"
                                                           Visibility="{Binding IsCompatible, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="⊘" FontSize="40" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding EmptyTitle}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding EmptyText}" FontSize="12.5" Foreground="{StaticResource TextMuted}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Error -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVis}}">
                        <TextBlock Text="Não foi possível carregar" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource BodyText}" TextAlignment="Center" Margin="0,8,0,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="↻  Tentar novamente" HorizontalAlignment="Center"
                                Margin="0,16,0,0" Command="{Binding RetryCommand}"/>
                    </StackPanel>
                </Grid>

                <!-- Pagination -->
                <Grid Grid.Row="3" Margin="0,8,0,0">
                    <TextBlock Text="{Binding PageText}" FontSize="12.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource PaginationButton}" Content="‹" FontSize="16" ToolTip="Página anterior"
                                Command="{Binding PreviousPageCommand}"/>
                        <Button Style="{StaticResource PaginationButton}" Content="›" FontSize="16" ToolTip="Próxima página" Margin="8,0,0,0"
                                Command="{Binding NextPageCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ── DETAIL PANEL ── -->
            <Border Grid.Column="2" Width="370" Background="{StaticResource BgSurface}"
                    BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1,0,0,0"
                    DataContext="{Binding Detail}"
                    Visibility="{Binding Converter={StaticResource HasValueToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ScrollViewer Style="{StaticResource MinimalScrollViewer}" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Height="230" Background="White">
                                <TextBlock Text="▦" FontSize="44" Foreground="#D4D4D8"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image ui:RemoteImage.Url="{Binding ImageUrl}" ui:RemoteImage.DecodeWidth="740"
                                       Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Button Style="{StaticResource HeartButton}" DataContext="{Binding Card}"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"
                                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                <Button Style="{StaticResource HeartButton}" Content="" ToolTip="Fechar"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10"
                                        Command="{Binding DataContext.CloseDetailCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="#B30E0E12" CornerRadius="15" Width="30" Height="30">
                                                <TextBlock Text="✕" FontSize="12" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#E60E0E12"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <StackPanel Margin="20,16,20,16">
                                <TextBlock Text="{Binding CategoryText}" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"
                                           TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="23"/>
                                <Border Style="{StaticResource PriceBadge}" DataContext="{Binding Card}"
                                        HorizontalAlignment="Left" Margin="0,10,0,0">
                                    <TextBlock Text="{Binding PriceText}" FontSize="11.5" FontWeight="SemiBold" Foreground="White"/>
                                </Border>

                                <!-- Loading / load error -->
                                <ProgressBar Style="{StaticResource ThinProgress}" IsIndeterminate="True" Margin="0,16,0,0"
                                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                                <Border Style="{StaticResource ErrorBanner}" Margin="0,16,0,0"
                                        Visibility="{Binding LoadError, Converter={StaticResource HasValueToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding LoadError}" Foreground="{StaticResource Danger}" FontSize="12.5" TextWrapping="Wrap"/>
                                        <Button Style="{StaticResource LinkButton}" Content="Tentar novamente" Margin="0,6,0,0"
                                                HorizontalAlignment="Left" Command="{Binding RetryCommand}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Metadata -->
                                <Grid Margin="0,18,0,0" Visibility="{Binding IsLoaded, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Versão mínima" Style="{StaticResource MetaLabel}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding RevitVersionText}" Style="{StaticResource MetaValue}"/>
                                    <TextBlock Grid.Row="1" Text="Paramétrica" Style="{StaticResource MetaLabel}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ParametricText}" Style="{StaticResource MetaValue}"/>
                                    <TextBlock Grid.Row="2" Text="Marca" Style="{StaticResource MetaLabel}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BrandText}" Style="{StaticResource MetaValue}"/>
                                    <TextBlock Grid.Row="3" Text="Tamanho do arquivo" Style="{StaticResource MetaLabel}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource MetaValue}"/>
                                    <TextBlock Grid.Row="4" Text="Downloads" Style="{StaticResource MetaLabel}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DownloadCountText}" Style="{StaticResource MetaValue}"/>
                                </Grid>

                                <TextBlock Text="{Binding Description}" Style="{StaticResource BodyText}" FontSize="12.5" Margin="0,10,0,0"
                                           Visibility="{Binding Description, Converter={StaticResource HasValueToVis}}"/>
                                <TextBlock Text="{Binding TagsText}" FontSize="11.5" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,12,0,0"
                                           Visibility="{Binding TagsText, Converter={StaticResource HasValueToVis}}"/>

                                <Button Style="{StaticResource LinkButton}" Content="Ver página da família no site ↗" Margin="0,14,0,0"
                                        HorizontalAlignment="Left" Command="{Binding OpenPageCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Actions -->
                    <Border Grid.Row="1" Background="{StaticResource BgToolbar}" BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="0,1,0,0" Padding="20,14,20,16">
                        <StackPanel>
                            <Border Style="{StaticResource WarningBanner}" Margin="0,0,0,10"
                                    Visibility="{Binding BlockedReason, Converter={StaticResource HasValueToVis}}">
                                <TextBlock Text="{Binding BlockedReason}" Foreground="{StaticResource TextPrimary}" FontSize="12.5" TextWrapping="Wrap"/>
                            </Border>
                            <Border Style="{StaticResource InfoBanner}" Margin="0,0,0,10"
                                    Visibility="{Binding StatusMessage, Converter={StaticResource HasValueToVis}}">
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextPrimary}" FontSize="12.5" TextWrapping="Wrap"/>
                            </Border>
                            <Border Style="{StaticResource ErrorBanner}" Margin="0,0,0,10"
                                    Visibility="{Binding ErrorMessage, Converter={StaticResource HasValueToVis}}">
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Danger}" FontSize="12.5" TextWrapping="Wrap"/>
                            </Border>

                            <ProgressBar Style="{StaticResource ThinProgress}" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Margin="0,0,0,10"
                                         Visibility="{Binding IsInserting, Converter={StaticResource BoolToVis}}"/>

                            <Button Style="{StaticResource PrimaryButton}" Height="44" Command="{Binding InsertCommand}"
                                    Visibility="{Binding ShowInsert, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <TextBlock Text="↓  Inserir no projeto"
                                               Visibility="{Binding IsInserting, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                    <TextBlock Text="Baixando…" Visibility="{Binding IsInserting, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Button>

                            <!-- Buy this family on the site -->
                            <Button Style="{StaticResource BuyButton}" Height="46" Command="{Binding PurchaseCommand}"
                                    Visibility="{Binding HasPurchaseUrl, Converter={StaticResource BoolToVis}}">
                                <TextBlock>
                                    <Run Text="{Binding PurchaseText, Mode=OneWay}"/>
                                    <Run Text="  ↗" FontWeight="Normal"/>
                                </TextBlock>
                            </Button>

                            <!-- Subscribe: main action when the family cannot be bought separately -->
                            <Button Style="{StaticResource PrimaryButton}" Height="44" Content="Assinar um plano  ↗"
                                    Command="{Binding PlansCommand}"
                                    Visibility="{Binding ShowPlansPrimary, Converter={StaticResource BoolToVis}}"/>
                            <Button Style="{StaticResource SecondaryButton}" Height="40" Margin="0,8,0,0"
                                    Content="Ou assine um plano e baixe sem pagar por família  ↗"
                                    Command="{Binding PlansCommand}"
                                    Visibility="{Binding ShowPlansSecondary, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
